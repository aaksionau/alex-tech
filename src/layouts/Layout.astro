---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import SystemBackground from '../components/SystemBackground.astro';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const {
  title,
  description = 'Alex — .NET, Azure, and AI software engineer.',
  wide = false,
} = Astro.props;
const containerWidth = wide ? 'max-w-6xl' : 'max-w-4xl';

const navItems = [
  { href: '/experience', label: 'Experience' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/talk', label: 'Talk' },
  { href: '/about', label: 'About' },
];

const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} · Alex</title>
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="min-h-screen font-sans antialiased">
    <SystemBackground />
    <header class:list={['mx-auto flex items-center justify-between px-6 py-6', containerWidth]}>
      <a href="/" class="font-heading text-lg font-semibold">Alex</a>
      <nav class="flex items-center gap-6 text-sm text-(--color-muted)">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'hover:text-(--color-foreground)',
                isActive(item.href) && 'font-medium text-(--color-foreground)',
              ]}
            >
              {item.label}
            </a>
          ))
        }
        <ThemeToggle />
      </nav>
    </header>
    <main class:list={['mx-auto px-6 pb-20', containerWidth]}>
      <slot />
    </main>
  </body>
</html>
