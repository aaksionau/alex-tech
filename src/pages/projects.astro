---
import Layout from '../layouts/Layout.astro';
import ProjectsGrid from '../components/ProjectsGrid.svelte';
import projects from '../data/projects.json';
---

<Layout title="Projects" description="Alex's project portfolio — CH Robinson, University of Minnesota, and personal projects, filterable by technology.">
  <section class="flex flex-col gap-4 py-16">
    <p class="font-mono text-sm text-(--color-accent)">Portfolio</p>
    <h1 class="font-heading text-3xl font-semibold sm:text-4xl">Projects</h1>
    <p class="max-w-xl text-(--color-muted)">
      Project work grouped by year, from client engagements to personal builds. Filter by
      technology to confirm hands-on experience.
    </p>
  </section>
  <section class="pb-24">
    <ProjectsGrid years={projects.years} client:visible />
  </section>
</Layout>
