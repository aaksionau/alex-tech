---
import Layout from '../layouts/Layout.astro';
import TalkWidget from '../components/TalkWidget.svelte';
import experience from '../data/experience.json';
import projects from '../data/projects.json';
---

<Layout
  title="Talk"
  description="Have a live voice conversation with an AI built on Alex's real career experience."
>
  <section class="flex flex-col gap-4 py-16">
    <p class="font-mono text-sm text-(--color-accent)">Live voice</p>
    <h1 class="font-heading text-3xl font-semibold sm:text-4xl">Talk to Alex</h1>
    <p class="max-w-xl text-(--color-muted)">
      Ask about his career, projects, and the tech behind them — answered live, in his own voice,
      by an AI grounded in his real experience.
    </p>
  </section>
  <section class="pb-24">
    <TalkWidget roles={experience.roles} years={projects.years} client:load />
  </section>
</Layout>
