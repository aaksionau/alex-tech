---
import Layout from '../layouts/Layout.astro';
import LatestPosts from '../components/LatestPosts.astro';
import SocialLinks from '../components/SocialLinks.astro';

const focusAreas = ['.NET', 'Azure', 'Event-Driven Systems', 'Applied AI'];
---

<Layout title="Home" wide>
  <div class="grid gap-12 py-16 lg:grid-cols-[280px_1fr] lg:gap-16">
    <aside class="flex flex-col gap-6 lg:sticky lg:top-12 lg:h-fit">
      <img
        src="https://aaksionau.github.io/img/aaksionau_profile.jpg"
        alt="Aliaksei Aksionau"
        width="80"
        height="80"
        class="h-20 w-20 rounded-full border border-(--color-border) object-cover"
      />
      <div class="flex flex-col gap-2">
        <h1 class="font-heading text-2xl font-semibold">Aliaksei Aksionau</h1>
        <p class="text-sm text-(--color-muted)">Senior full-stack engineer building on Azure.</p>
      </div>
      <p class="text-sm leading-relaxed text-(--color-muted)">
        10+ years on .NET and Azure, recently focused on event-driven systems (Kafka,
        Elasticsearch) and applied AI.
      </p>
      <ul class="flex flex-wrap gap-2">
        {
          focusAreas.map((area) => (
            <li class="rounded-full border border-(--color-border) px-3 py-1 font-mono text-xs text-(--color-muted)">
              {area}
            </li>
          ))
        }
      </ul>
      <SocialLinks class="flex-col" />
      <div class="flex flex-col gap-3 text-sm">
        <a
          href="/about"
          class="rounded-md bg-(--color-accent) px-4 py-2 text-center font-medium text-(--color-accent-foreground) transition-opacity hover:opacity-90"
        >
          About me
        </a>
        <a
          href="/talk"
          class="flex items-center justify-center gap-2 rounded-md border border-(--color-accent) px-4 py-2 text-(--color-accent) transition-colors hover:bg-(--color-accent) hover:text-(--color-accent-foreground)"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true">
            <path
              d="M12 2C6.48 2 2 5.94 2 10.8c0 2.76 1.44 5.22 3.7 6.83-.12.99-.5 2.4-1.55 3.87a.5.5 0 0 0 .55.78c2.06-.55 3.68-1.5 4.72-2.24.83.16 1.7.24 2.58.24 5.52 0 10-3.94 10-8.8S17.52 2 12 2z"
            ></path>
          </svg>
          Talk to my digital self
        </a>
      </div>
    </aside>
    <div>
      <LatestPosts />
    </div>
  </div>
</Layout>
