---
import Layout from '../layouts/Layout.astro';
import LatestPosts from '../components/LatestPosts.astro';
---

<Layout title="Home">
  <section class="flex min-h-[70vh] flex-col justify-center gap-6">
    <p class="font-mono text-sm text-(--color-accent)">.NET · Azure · AI</p>
    <h1 class="font-heading text-4xl font-semibold sm:text-5xl">
      Hi, I&rsquo;m Alex — a software engineer building on Azure.
    </h1>
    <p class="max-w-xl text-lg text-(--color-muted)">
      I design and ship production systems on .NET and Azure, with a growing focus on applied AI.
      This site is itself an example: an Astro frontend, Azure Functions API, and Azure AI Foundry
      voice bot you can talk to about my experience.
    </p>
    <div class="flex gap-4 text-sm">
      <a
        href="https://github.com/aaksionau"
        class="rounded-md border border-(--color-border) px-4 py-2 hover:border-(--color-accent)"
      >
        GitHub
      </a>
      <a
        href="https://www.linkedin.com/in/aliaksei-aksionau/"
        class="rounded-md border border-(--color-border) px-4 py-2 hover:border-(--color-accent)"
      >
        LinkedIn
      </a>
      <a
        href="/about"
        class="rounded-md bg-(--color-accent) px-4 py-2 text-(--color-accent-foreground)"
      >
        About me
      </a>
    </div>
  </section>
  <LatestPosts />
</Layout>
