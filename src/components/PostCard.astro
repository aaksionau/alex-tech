---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const formattedDate = post.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="flex flex-col gap-2 border-b border-(--color-border) pb-8">
  <a href={`/blog/${post.id}`} class="group flex flex-col gap-2">
    <p class="font-mono text-xs text-(--color-muted)">{formattedDate}</p>
    <h2 class="font-heading text-xl font-semibold group-hover:text-(--color-accent)">
      {post.data.title}
    </h2>
    <p class="text-(--color-muted)">{post.data.description}</p>
  </a>
  {
    post.data.tags.length > 0 && (
      <ul class="flex flex-wrap gap-2 pt-1">
        {post.data.tags.map((tag) => (
          <li class="rounded-full border border-(--color-border) px-2 py-0.5 font-mono text-xs text-(--color-muted)">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</article>
