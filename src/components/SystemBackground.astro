<div
  class="pointer-events-none fixed inset-0 -z-10 overflow-hidden text-(--color-foreground) opacity-[0.07]"
  aria-hidden="true"
>
  <svg class="h-full w-full" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
    <defs>
      <pattern id="system-grid" width="180" height="180" patternUnits="userSpaceOnUse">
        <path
          d="M0 30 H50 M50 30 V90 M50 90 H130 M130 90 V150 M130 150 H180 M90 0 V50 M90 50 H150 M150 50 V120 M150 120 H180 M0 120 H30 M30 120 V180 M30 60 H0 M30 60 V0"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
        />
        <circle cx="50" cy="30" r="2.5" fill="currentColor" />
        <circle cx="50" cy="90" r="2.5" fill="currentColor" />
        <circle cx="130" cy="90" r="2.5" fill="currentColor" />
        <circle cx="130" cy="150" r="2.5" fill="currentColor" />
        <circle cx="90" cy="50" r="2.5" fill="currentColor" />
        <circle cx="150" cy="50" r="2.5" fill="currentColor" />
        <circle cx="30" cy="120" r="2.5" fill="currentColor" />
        <circle cx="30" cy="60" r="2.5" fill="currentColor" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#system-grid)" />
  </svg>
</div>
